# Copiar este archivo a .env y completar con valores propios. .env está en .gitignore:
# nunca se debe commitear.

DATABASE_URL=postgresql+psycopg://passport_user:passport_pass@localhost:5432/passport_db

# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

JWT_EXPIRE_MINUTES=30

# Clave para cifrar datos sensibles (email) dentro del JWT. Generar con:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

SESSION_EXPIRE_MINUTES=60

# true en cualquier entorno servido por HTTPS (y también en localhost por HTTP, que los
# navegadores tratan como contexto seguro). Poner en false solo para probar con curl sobre
# HTTP plano contra una IP que no sea localhost.
COOKIE_SECURE=true
